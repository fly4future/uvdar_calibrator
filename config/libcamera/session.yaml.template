root: ./
name: uvdar_calibrator
socket_name: f4f
attach: false
tmux_options: -f /etc/ctu-mrs/tmux.conf
pre_window:
  - export RMW_IMPLEMENTATION=rmw_zenoh_cpp
startup_window: uvdar_calibrator
windows:
  - zenoh: ros2 run rmw_zenoh_cpp rmw_zenohd

  - libcamera: ros2 launch libcamera_ros_driver camera.launch.py uav_name:=uvdar_calibrator suffix:=front custom_config:=/ros2_ws/src/uvdar_calibrator/config/libcamera/camera_custom_config.yaml calib_url:=file:///ros2_ws/src/uvdar_calibrator/config/libcamera/camera_calib.yaml

  - uvdar_calibrator: ros2 run uvdar_calibrator cameracalibrator --output_dir /calibration_output --camera_id "__CAMERA_ID__" image:=/uvdar_calibrator/rpi_camera_front/image_raw
